{
  "name": "langchain-autonomo",
  "version": "0.1.0",
  "description": "LangChain.js tools for Autonomo: an agent finds the right paid API, sees its price and pays for a call in USDG or $AUTONOMO on Robinhood Chain, within spending caps.",
  "homepage": "https://autonomo.fun/docs/langchain",
  "author": "Autonomo (https://autonomo.fun)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "x402",
    "autonomo",
    "ai-agents",
    "robinhood-chain",
    "usdg",
    "payments"
  ],
  "dependencies": {
    "autonomo-sdk": "^0.1.0",
    "zod": "^3.25.76 || ^4"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.3.5",
    "@types/node": "26.6.5",
    "langchain": "1.6.3",
    "typescript": "7.0.2"
  }
}
