{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/v1/price/:token",
      "destination": "/api/price?token=:token"
    },
    {
      "source": "/v1/tx/:hash",
      "destination": "/api/tx?hash=:hash"
    },
    {
      "source": "/v1/portfolio/:wallet",
      "destination": "/api/portfolio?wallet=:wallet"
    },
    {
      "source": "/v1/page",
      "destination": "/api/page"
    },
    {
      "source": "/v1/launches",
      "destination": "/api/launches"
    },
    {
      "source": "/v1/risk/:token",
      "destination": "/api/risk?token=:token"
    },
    {
      "source": "/v1/dev/:token",
      "destination": "/api/dev?token=:token"
    },
    {
      "source": "/v1/holders/:token",
      "destination": "/api/holders?token=:token"
    },
    {
      "source": "/v1/gas",
      "destination": "/api/gas"
    },
    {
      "source": "/v1/payment/:hash",
      "destination": "/api/payment?hash=:hash"
    },
    {
      "source": "/v1/endpoint",
      "destination": "/api/endpoint"
    },
    {
      "source": "/v1/site",
      "destination": "/api/site"
    },
    {
      "source": "/v1/offers",
      "destination": "/api/ostrapad"
    },
    {
      "source": "/v1/health",
      "destination": "/api/health"
    }
  ]
}
