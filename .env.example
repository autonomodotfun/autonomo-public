# Neon connection string. Leave unset locally to use an embedded PGlite database in ./.pglite
DATABASE_URL=

# Password for /admin (HTTP basic auth, any username)
ADMIN_PASSWORD=

# Public site URL, used for sitemap and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paid API tier (x402). Off unless PRO_PAY_TO and at least one rail below are set. ---
# Wallet that receives all paid-tier payments
PRO_PAY_TO=

# Price per call in USD, used by the USDG and USDC rails
PRO_PRICE_USD=0.01

# Robinhood Chain rails, settled by this server. FACILITATOR_PRIVATE_KEY is a gas-only wallet
# (keep a little ETH on Robinhood Chain in it, nothing else). Required for USDG and $AUTONOMO.
FACILITATOR_PRIVATE_KEY=
# USDG rail (EIP-3009): set to 1 to accept USDG
PRO_ACCEPT_USDG=
# $AUTONOMO rail (Permit2): whole tokens per call
PRO_AUTONOMO_AMOUNT=

# Optional USDC rail: network (CAIP-2) and an x402 facilitator that settles it, e.g. eip155:8453 for Base
PRO_USDC_NETWORK=
PRO_USDC_FACILITATOR_URL=
# Optional dedicated RPC; defaults to the public Robinhood Chain RPC
ROBINHOOD_RPC_URL=

# --- Hosted gateways and owner dashboard ---
# Signs owner wallet sessions (Sign-In with Ethereum). At least 32 random characters; sign-in is off without it.
SESSION_SECRET=
# Encrypts owners' upstream API keys at rest (AES-256-GCM). At least 32 random characters.
GATEWAY_SECRET_KEY=
# Development only: let gateways call http:// and private addresses (e.g. a local test server)
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=

# Optional Privy sign-in for the dashboard (email, Google, X or wallet; embedded wallet for new users).
# Needs SESSION_SECRET too. Without these, the dashboard uses Sign-In with Ethereum only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the app's JWT verification key from the Privy dashboard, to verify tokens without a network call
PRIVY_VERIFICATION_KEY=
