# Neon connection string. Leave unset locally to use an embedded PGlite database in ./.pglite
DATABASE_URL=

# Password for /admin (HTTP basic auth, any username)
ADMIN_PASSWORD=

# Public site URL, used for sitemap and canonical links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Settles USDG and $AUTONOMO payments on Robinhood Chain. A gas-only wallet: keep a little ETH on Robinhood Chain in
# it, nothing else.
FACILITATOR_PRIVATE_KEY=
# Optional dedicated RPC; defaults to the public Robinhood Chain RPC. Server-side only: it holds a key.
# It must allow wide eth_getLogs ranges: risk checks, launches and Verified search millions of blocks.
ROBINHOOD_RPC_URL=

# --- Hosted gateways and owner dashboard ---
# Signs owner wallet sessions (Sign-In with Ethereum). At least 32 random characters; sign-in is off without it.
SESSION_SECRET=
# Encrypts owners' upstream API keys at rest (AES-256-GCM). At least 32 random characters.
GATEWAY_SECRET_KEY=
# Dollar value of $AUTONOMO, roughly, a wallet must hold for its APIs to show as Verified (default 27; 0 turns it off).
VERIFIED_USD=
# Burn on paid calls (contracts/). With a factory set, gateways are paid at each payee's burn
# splitter, which burns 5% of $AUTONOMO and buys back and burns with 5% of USDG. A payment flushes a splitter once it
# holds 1,000 $AUTONOMO or 0.10 USDG, and the daily cron at /api/cron/burn catches the rest. BURN_KEEPER_PRIVATE_KEY is the
# BuybackBurner's keeper: its own gas-only wallet, not the facilitator, so flushes can't clash with settling a payment.
BURN_SPLITTER_FACTORY=
BUYBACK_BURNER=
BURN_KEEPER_PRIVATE_KEY=
# The block the burn contracts were deployed in, where the search for burn receipts starts
BURN_START_BLOCK=
# Gloam cash-out payments (src/lib/gloam.ts): every gateway that accepts USDG also accepts a payment cashed out from a
# private Gloam balance straight to its splitter. Set to "off" to stop offering it everywhere.
GLOAM_CASHOUT=
# Your own test wallets, comma-separated: their payments don't count as outside payers in the track record
TRACK_RECORD_EXCLUDE=
# Development only: let gateways call http:// and private addresses (e.g. a local test server)
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=

# Optional Privy sign-in for the dashboard (email, Google, X or wallet; embedded wallet for new users).
# Needs SESSION_SECRET too. Without these, the dashboard uses Sign-In with Ethereum only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: the app's JWT verification key from the Privy dashboard, to verify tokens without a network call
PRIVY_VERIFICATION_KEY=
