# Copy this file to .env (in this folder) and fill it in. .env is git-ignored.

# Private key of a dedicated test wallet for the agent (0x + 64 hex characters).
# Fund it on Robinhood Chain with a little USDG, and for $AUTONOMO payments some $AUTONOMO plus a tiny bit of ETH.
AGENT_PRIVATE_KEY=

# Optional: the gateway URL to call (defaults to the Token Price demo)
GATEWAY_URL=https://autonomo.fun/x/token-price/price/autonomo
