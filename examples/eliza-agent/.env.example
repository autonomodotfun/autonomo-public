# Copy to .env and fill in. .env is gitignored; npm run chat reads it with node --env-file.

# Your model provider key (the agent picks actions with it).
ANTHROPIC_API_KEY=

# A wallet just for this test, holding a little USDG on Robinhood Chain. Leave empty to test without paying.
AUTONOMO_WALLET_KEY=

# Pay in USDG only, at most 0.02 per call and 0.05 for the day.
AUTONOMO_PAY_WITH=usdg
AUTONOMO_MAX_USDG_PER_CALL=0.02
AUTONOMO_DAILY_USDG=0.05
